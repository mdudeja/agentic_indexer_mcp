{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "bun",
            "internalConsoleOptions": "openOnSessionStart",
            "request": "launch",
            "name": "Debug Index",
            "runtime": "bun",
            "runtimeArgs": [
                "run",
                "index",
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "watchMode": false
        },
        {
            "type": "bun",
            "internalConsoleOptions": "openOnSessionStart",
            "request": "launch",
            "name": "Debug Index File",
            "runtime": "bun",
            "runtimeArgs": [
                "run",
                "index-file",
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "watchMode": false
        },
        {
            "type": "bun",
            "internalConsoleOptions": "openOnSessionStart",
            "request": "launch",
            "name": "Debug Remove Docstrings",
            "runtime": "bun",
            "runtimeArgs": [
                "run",
                "remove-docstrings",
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "watchMode": false
        },
        {
            "type": "bun",
            "internalConsoleOptions": "openOnSessionStart",
            "request": "launch",
            "name": "Debug Inspect",
            "runtime": "bun",
            "runtimeArgs": [
                "run",
                "inspect",
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false,
            "watchMode": false
        },
    ]
}